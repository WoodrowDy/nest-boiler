# shellcheck shell=bash
#
# DB 에 닿는 방법. 인프라마다 다른 유일한 부분이다.
#
#   cp scripts/db-connect.sh.example scripts/db-connect.sh
#
# ★ 이 파일이 있으면 _db-env.sh 가 자동으로 source 한다. 없으면 그냥 넘어간다.
#   env 파일을 읽은 뒤에 불리므로 DB_HOST · DB_PORT · DB_NAME 이 이미 잡혀 있다.
#
# ★ 값을 덮어쓸 때는 반드시 export 한다.
#   실제 접속은 자식 프로세스(typeorm)가 하고, dotenv 는 이미 있는 process.env 를
#   덮지 않는다 — 그래서 여기서 export 한 값이 env 파일 값보다 우선한다.
#
# ★ _db-env.sh 를 직접 고치지 않는다.
#   보일러를 업데이트할 때 그 자리가 부딪힌다. 인프라 코드는 여기에만 둔다.
#
# ★ 비밀번호를 이 파일에 적지 않는다. envs/.env.<env> 나 키 인증을 쓴다.
#   이 파일을 커밋할지는 프로젝트가 정한다 — 비밀이 없으면 커밋해도 된다.

# ── 예시 1. ssh 터널 ────────────────────────────────────────────────
#
# DB 가 사설 서브넷에 있고 로컬에서 작업해야 할 때. 경유 서버를 한 번 거친다.
# ★ 서버에 ssh 로 들어가서 돌린다면 필요 없다 — 서버는 이미 그 안에 있다.
#
# LOCAL_PORT=6543
# if ! lsof -n -P -iTCP@127.0.0.1:"$LOCAL_PORT" -sTCP:LISTEN -t >/dev/null 2>&1; then
#   ssh -4 -fnN -o ExitOnForwardFailure=yes \
#       -L "127.0.0.1:${LOCAL_PORT}:${DB_HOST}:${DB_PORT}" "bastion-${ENV}"
#   sleep 1
# fi
# if ! lsof -n -P -iTCP@127.0.0.1:"$LOCAL_PORT" -sTCP:LISTEN -t >/dev/null 2>&1; then
#   echo "✗ 터널이 열리지 않았습니다."
#   echo "  → {여기에 이 프로젝트의 접속 조건을 적으세요 — VPN · IP 허용목록 등}"
#   exit 1
# fi
# export DB_HOST=127.0.0.1
# export DB_PORT="$LOCAL_PORT"

# ── 예시 2. Cloud SQL Auth Proxy ───────────────────────────────────
#
# cloud-sql-proxy "$INSTANCE" --port 6543 &
# sleep 2
# export DB_HOST=127.0.0.1
# export DB_PORT=6543

# ── 예시 3. AWS RDS IAM 인증 ────────────────────────────────────────
#
# 비밀번호 대신 15분짜리 토큰을 발급받는다. env 파일에 비밀번호를 두지 않아도 된다.
#
# export DB_PASSWORD="$(aws rds generate-db-auth-token \
#   --hostname "$DB_HOST" --port "$DB_PORT" --username "$DB_USERNAME")"

# ── 아무것도 필요 없으면 ────────────────────────────────────────────
#
# 이 파일을 아예 만들지 않으면 된다. env 파일의 값으로 그대로 붙는다.
