## 개발 서버 환경변수 템플릿
## 사용: cp envs/.env.dev.example envs/.env.dev
## (envs/.env.dev 은 git 에 커밋되지 않습니다)
##
## ★ 이 파일은 배포 서버에 둡니다. 개발자 노트북에 실제 값을 두지 않습니다.
##   마이그레이션도 서버에 ssh 로 들어가서 돌립니다 —  pnpm migrate:show:dev

## Timezone
TZ=Asia/Seoul

## APP
PORT=8080
USE_LOCAL_HTTPS_OPTIONS=false

## DATABASE
DB_HOST=
DB_PORT=5432
DB_SCHEMA="public"
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_LOGGING=false
DB_MAX_QUERY_EXECUTION=20000

## ★ 선택 — 환경과 DB 가 어긋나는 것을 막는 교차 검증.
##
##   여기에 값을 적어두면 migrate.sh 가 위 DB_NAME 과 대조하고, 다르면 멈춥니다.
##   prod 설정을 실수로 이 파일에 복사한 경우를 잡습니다 — 인자는 dev 인데
##   실제로는 운영 DB 에 마이그레이션이 나가는 상황입니다.
##
##   환경마다 DB 가 완전히 분리돼 있다면 비워두어도 됩니다. 비우면 검사하지 않고
##   접속 대상만 보여줍니다.
EXPECTED_DB_NAME=

# JWT
JWT_SECRET=
