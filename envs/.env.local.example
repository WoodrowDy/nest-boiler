## 앱 로컬 환경변수 템플릿
## 사용: cp envs/.env.local.example envs/.env.local
## (envs/.env.local 은 git 에 커밋되지 않습니다)

## Timezone
TZ=Asia/Seoul

## APP
PORT=8080
USE_LOCAL_HTTPS_OPTIONS=false

## DATABASE (docker-compose 로 띄운 로컬 Postgres 기준)
DB_HOST=localhost
DB_PORT=5433
DB_SCHEMA="public"
DB_NAME=nest-boiler
DB_USERNAME=root
DB_PASSWORD=password
DB_LOGGING=true
DB_MAX_QUERY_EXECUTION=20000

# JWT
JWT_SECRET=local_jwt_secret
