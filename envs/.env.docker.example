# docker-compose 가 읽는 로컬 Postgres 컨테이너 설정 템플릿
# 사용: cp envs/.env.docker.example envs/.env.docker 후 값 채우기
# (envs/.env.docker 는 git 에 커밋되지 않습니다)
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=nest-boiler-test
TZ=Asia/Seoul

# host 포트는 이 파일로 못 바꿉니다 — env_file 은 컨테이너 안으로만 주입됩니다.
# 바꾸려면 셸에서 POSTGRES_PORT 를 주거나 docker-compose.yml 의 기본값을 고치세요 (기본 5434)
